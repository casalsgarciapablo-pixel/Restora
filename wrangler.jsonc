{
  "name": "restora",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  // El Worker solo genera /sitemap.xml y /robots.txt; todo lo demás cae en los archivos estáticos a
  // través del binding ASSETS, así que el sitio se comporta igual que antes.
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // run_worker_first es imprescindible aquí. Por defecto Cloudflare resuelve primero los archivos
    // estáticos y solo llama al Worker si NINGUNA regla de assets responde; como not_found_handling
    // sí responde (con el 404), el Worker no llegaba a ejecutarse nunca y /sitemap.xml devolvía 404.
    // Con esta lista, esas dos rutas concretas van al Worker antes de mirar los archivos.
    "run_worker_first": ["/sitemap.xml", "/robots.txt"],
    // Sin esto Cloudflare devuelve su propia página de error genérica en cualquier ruta que no exista.
    // "single-page-application" NO vale: devolvería index.html con estado 200 y los buscadores
    // indexarían rutas inexistentes como si fueran páginas buenas.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
